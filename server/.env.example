# Application
NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/family-finance-tracker

# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# JWT (reserved for authentication - replace with a long random string before enabling auth)
JWT_SECRET=development-only-secret-change-me
JWT_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
